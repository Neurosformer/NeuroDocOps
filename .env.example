NEURODOCOPS_ENV=development
NEURODOCOPS_API_TITLE=NeuroDocOps API
NEURODOCOPS_STORAGE_BACKEND=memory
NEURODOCOPS_JOB_QUEUE_BACKEND=memory
NEURODOCOPS_OBJECT_STORAGE_BACKEND=memory
NEURODOCOPS_OCR_PROVIDER=mock
NEURODOCOPS_EXTRACTION_PROVIDER=rule_based_insurance
NEURODOCOPS_REASONING_PROVIDER=none
NEURODOCOPS_SEARCH_PROVIDER=none
NEURODOCOPS_AUTH_PROVIDER=dev
NEURODOCOPS_TELEMETRY_PROVIDER=local
NEURODOCOPS_SECRET_PROVIDER=env
NEURODOCOPS_LIVE_OCR_ENABLED=false
NEURODOCOPS_PROVIDER_TIER=free
NEURODOCOPS_MAX_LIVE_OCR_PAGES=0
NEURODOCOPS_OCR_CACHE_ENABLED=true
NEURODOCOPS_DB_CONNECT_ATTEMPTS=5
NEURODOCOPS_WORKER_DEQUEUE_TIMEOUT_SECONDS=5
DATABASE_URL=postgresql://neurodocops:neurodocops@localhost:5432/neurodocops
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=neurodocops-dev
OBJECT_STORAGE_ACCESS_KEY=neurodocops
OBJECT_STORAGE_SECRET_KEY=neurodocops-dev-secret
OBJECT_STORAGE_REGION=us-east-1
